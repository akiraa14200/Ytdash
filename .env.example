# Existing Supabase project: youtube-creator-dashboard
NEXT_PUBLIC_SUPABASE_URL=https://sdwscupudnuyqoaxaxwf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth credentials (create OAuth Web client; enable YouTube Data API v3 and YouTube Analytics API)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# For Vercel production use https://ytdash-z-hub.vercel.app/api/youtube/callback and add it to the Google OAuth client

# Generate 32 random bytes and base64 encode them; used to encrypt stored OAuth tokens.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Optional: app URL in production
APP_URL=http://localhost:3000